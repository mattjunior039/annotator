{
  "name": "private-annotator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b",
    "test": "vitest run",
    "test:browser": "npm run fixtures && playwright test",
    "test:local-ai": "npm run fixtures && playwright test --config playwright.local-ai.config.ts",
    "test:integrations": "npm run fixtures && playwright test --config playwright.integrations.config.ts",
    "test:pages": "npm run fixtures && playwright test --config playwright.pages.config.ts",
    "test:accessibility": "npm run fixtures && playwright test --config playwright.accessibility.config.ts",
    "fixtures": "node scripts/fixtures.mjs",
    "signaling": "node services/signaling/node-server.ts",
    "bridge": "node --experimental-strip-types services/bridge/node-server.ts",
    "test:bridge": "vitest run services/bridge",
    "check:bridge": "tsc --project services/bridge/tsconfig.json",
    "test:live": "npm run fixtures && playwright test --config playwright.live.config.ts",
    "test:live:worker": "LIVE_RELAY=worker npm run test:live",
    "test:sharing": "npm run fixtures && playwright test --config playwright.sharing.config.ts",
    "benchmark:corpus": "node scripts/corpus.mjs",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "inventory": "npm sbom --sbom-format cyclonedx"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "aws4fetch": "^1.0.20",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.14.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "ws": "^8.22.0"
  }
}
